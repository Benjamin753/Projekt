[gd_scene load_steps=10 format=3]

[ext_resource type="Script" path="res://ball.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/ball/steel_ball.png" id="texture"]

[ext_resource type="Shader" path="res://assets/ball/steel_ball.gdshader" id="skin"]
[ext_resource type="Shader" path="res://assets/ball/ball_light.gdshader" id="light"]

[sub_resource type="ShaderMaterial" id="skin_material"]
shader = ExtResource("skin")

[sub_resource type="ShaderMaterial" id="shadow_material"]
shader = ExtResource("light")
shader_parameter/shadow = true

[sub_resource type="ShaderMaterial" id="reflection_material"]
shader = ExtResource("light")

[sub_resource type="CircleShape2D" id="shape"]
radius = 10.0

[sub_resource type="PhysicsMaterial" id="material"]
friction = 0.18
bounce = 0.25

[node name="Ball" type="RigidBody2D"]
script = ExtResource("script")
mass = 1.0
inertia = 40.0
gravity_scale = 0.55
linear_damp_mode = 1
linear_damp = 0.04
angular_damp_mode = 1
angular_damp = 0.12
can_sleep = false
continuous_cd = 2
contact_monitor = true
max_contacts_reported = 12
freeze_mode = 1
physics_material_override = SubResource("material")

[node name="Collision" type="CollisionShape2D" parent="."]
shape = SubResource("shape")

[node name="Visual" type="Node2D" parent="."]
top_level = true
z_index = 3
texture_filter = 4

[node name="Shadow" type="ColorRect" parent="Visual"]
material = SubResource("shadow_material")
mouse_filter = 2

[node name="Sprite" type="Sprite2D" parent="Visual"]
material = SubResource("skin_material")
texture = ExtResource("texture")

[node name="Reflection" type="ColorRect" parent="Visual"]
material = SubResource("reflection_material")
mouse_filter = 2
